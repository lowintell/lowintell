// GENERATED by qs-glass from config.template.jsonc. Edit the template, not this file.
// "Grey Tide" theme — desaturated blue-violet dusk over water
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ascii-logo.txt",
    "color": { "1": "#94c0dc", "2": "#6a9fa0" },
    "padding": { "top": 1, "right": 3 }
  },

  "display": {
    "separator": " ",
    "color": { "keys": "#a9c1d1", "title": "#94c0dc" },
    "key": { "width": 3, "type": "icon" },
    "size": { "binaryPrefix": "iec", "ndigits": 1 },
    "percent": {
      "type": ["bar", "num-color"],
      "color": { "green": "#67a48f", "yellow": "#b59b78", "red": "#b56a7d" }
    }
  },

  "modules": [
    { "type": "title", "color": { "user": "#e2f0f8", "at": "#183654", "host": "#94c0dc" } },
    { "type": "separator", "string": "─", "color": "#6a8ca2" },

    { "type": "os", "key": " OS" },
    { "type": "kernel", "key": " Kernel" },
    { "type": "uptime", "key": " Uptime" },
    { "type": "shell", "key": " Shell" },
    { "type": "wm", "key": " WM" },
    { "type": "terminal", "key": " Terminal" },

    { "type": "break" },

    { "type": "cpu", "key": " CPU" },
    { "type": "gpu", "key": " GPU" },
    { "type": "memory", "key": "󰍛 Memory" },
    { "type": "disk", "key": " Disk" },

    { "type": "break" },

    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
