pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io
import qs.config

// Writes the current colour scheme for other programs and tells them to reload:
//  - kitty:    ~/.config/kitty/qs-colors.conf  (kitty.conf needs `include qs-colors.conf` once; reload via SIGUSR1)
//  - Hyprland: ~/.config/hypr/qs-colors.lua    (loaded by glass.lua; also applied live with `hyprctl eval`)
Singleton {
    id: root

    property string status: ""
    readonly property string kittyFile: Quickshell.env("HOME") + "/.config/kitty/qs-colors.conf"
    readonly property string ffTemplateFile: Quickshell.env("HOME") + "/.config/fastfetch/config.template.jsonc"
    readonly property string ffOutFile: Quickshell.env("HOME") + "/.config/fastfetch/config.jsonc"
    property bool ffPending: false
    readonly property string hyprFile: Quickshell.env("HOME") + "/.config/hypr/qs-colors.lua"

    // changes whenever any colour changes
    readonly property string signature: [Theme.base, Theme.text, Theme.textDim, Theme.textMute, Theme.accent,
                                         Theme.accent2, Theme.violet, Theme.good, Theme.warn, Theme.bad].join(",")
    onSignatureChanged: if (Settings.exportAuto && Settings.loaded) debounce.restart()

    function hex(c) { return c.toString(); }
    function mix(a, b, t) { return Qt.rgba(a.r * (1 - t) + b.r * t, a.g * (1 - t) + b.g * t, a.b * (1 - t) + b.b * t, 1); }
    function rgba(c, aa) { return "rgba(" + hex(c).slice(1) + aa + ")"; }

    function fastfetchVars() {
        const bg = Theme.base;
        const nm = c => hex(mix(c, bg, 0.30));
        return {
            text: hex(Theme.text), text_dim: hex(Theme.textDim), text_mute: hex(Theme.textMute),
            base: hex(bg), line: hex(Theme.line),
            accent: hex(Theme.accent), accent_muted: nm(Theme.accent),
            accent2: hex(Theme.accent2), accent2_muted: nm(Theme.accent2),
            violet: hex(Theme.violet), violet_muted: nm(Theme.violet),
            good: hex(Theme.good), good_muted: nm(Theme.good),
            warn: hex(Theme.warn), warn_muted: nm(Theme.warn),
            bad: hex(Theme.bad), bad_muted: nm(Theme.bad)
        };
    }
    function renderTemplate(tpl) {
        const v = fastfetchVars();
        return tpl.replace(/\{\{\s*([a-z0-9_]+)\s*\}\}/g, (m, k) => v[k] !== undefined ? v[k] : m);
    }

    function kittyConf() {
        const bg = Theme.base, fg = Theme.text;
        const nm = c => hex(mix(c, bg, 0.30));      // muted "normal" colours
        const br = c => hex(mix(c, fg, 0.12));      // brighter variants
        return [
            "# Generated by qs-glass. Do not edit by hand; change colours in the shell's settings.",
            "foreground " + hex(fg),
            "background " + hex(bg),
            "selection_foreground " + hex(bg),
            "selection_background " + hex(mix(Theme.accent, bg, 0.45)),
            "cursor " + hex(Theme.accent),
            "cursor_text_color " + hex(bg),
            "url_color " + hex(Theme.accent2),
            "color0 " + hex(Theme.bg0),
            "color8 " + hex(Theme.line),
            "color1 " + nm(Theme.bad), "color9 " + br(Theme.bad),
            "color2 " + nm(Theme.good), "color10 " + br(Theme.good),
            "color3 " + nm(Theme.warn), "color11 " + br(Theme.warn),
            "color4 " + nm(Theme.accent), "color12 " + br(Theme.accent),
            "color5 " + nm(Theme.violet), "color13 " + br(Theme.violet),
            "color6 " + nm(Theme.accent2), "color14 " + br(Theme.accent2),
            "color7 " + hex(mix(Theme.textDim, bg, 0.2)),
            "color15 " + hex(fg),
            "active_border_color " + hex(Theme.accent),
            "inactive_border_color " + hex(Theme.surface),
            "bell_border_color " + hex(Theme.warn),
            "active_tab_background " + hex(mix(Theme.accent, bg, 0.35)),
            "active_tab_foreground " + hex(bg),
            "inactive_tab_background " + hex(Theme.bg2),
            "inactive_tab_foreground " + hex(Theme.textMute),
            "tab_bar_background " + hex(bg),
            "mark1_foreground " + hex(bg),
            "mark1_background " + hex(Theme.accent),
            ""
        ].join("\n");
    }

    function hyprColors() {
        const a1 = rgba(mix(Theme.accent, Theme.base, 0.25), "ee");
        const a2 = rgba(Theme.accent2, "ee");
        const ia = rgba(Theme.surface, "aa");
        return {
            file: "-- Generated by qs-glass. Do not edit by hand.\nreturn {\n    active1 = \"" + a1 + "\",\n    active2 = \"" + a2 + "\",\n    inactive = \"" + ia + "\",\n}\n",
            eval: "hl.config({ general = { col = { active_border = { colors = { \"" + a1 + "\", \"" + a2 + "\" }, angle = 45 }, inactive_border = \"" + ia + "\" } } })"
        };
    }

    function apply() {
        const done = [];
        if (Settings.exportKitty) {
            kittyView.setText(kittyConf());
            reloadKitty.restart();
            done.push("kitty");
        }
        if (Settings.exportHyprland) {
            const h = hyprColors();
            hyprView.setText(h.file);
            Quickshell.execDetached(["hyprctl", "eval", h.eval]);
            done.push("Hyprland");
        }
        if (Settings.exportFastfetch) {
            ffPending = true;
            ffTemplate.reload();
            done.push("fastfetch");
        }
        status = done.length > 0 ? "Updated " + done.join(" + ") + " at " + Qt.formatTime(new Date(), "HH:mm:ss")
                                 : "Nothing enabled to update";
    }

    Timer { id: debounce; interval: 900; onTriggered: root.apply() }
    // give the file a moment to be written before asking kitty to reload
    Timer { id: reloadKitty; interval: 350; onTriggered: Quickshell.execDetached(["pkill", "-USR1", "-x", "kitty"]) }

    FileView {
        id: ffTemplate
        path: root.ffTemplateFile
        printErrors: false
        onLoaded: {
            if (!root.ffPending) return;
            root.ffPending = false;
            ffOut.setText(root.renderTemplate(text()));
        }
        onLoadFailed: {
            if (!root.ffPending) return;
            root.ffPending = false;
            root.status = "fastfetch: ~/.config/fastfetch/config.template.jsonc not found";
        }
    }
    FileView { id: ffOut; path: root.ffOutFile; printErrors: false }
    FileView { id: kittyView; path: root.kittyFile; printErrors: false }
    FileView { id: hyprView; path: root.hyprFile; printErrors: false }
}
