# ~/.config/dunst/dunstrc
# Theme: "Slate Tide" — matches the rofi config (storm-cloud slate, lavender horizon glow)
# Wayland/Hyprland: transparency comes from the alpha channel in the colors below.

[global]
    monitor = 0

    ### Geometry ###
    width = (300, 400)
    height = (0, 300)
    origin = top-right
    offset = (16, 16)
    scale = 0
    notification_limit = 5
    layer = overlay

    ### Progress bar ###
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 5

    ### Shape ###
    corner_radius = 14
    gap_size = 6

    ### Borders ###
    frame_width = 1
    frame_color = "#46495e"
    separator_color = frame
    separator_height = 1

    ### Text ###
    font = JetBrainsMono Nerd Font 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    ### Icons ###
    enable_recursive_icon_lookup = true
    icon_theme = "Papirus-Dark"
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48

    ### History ###
    sticky_history = yes
    history_length = 20

    ### Misc ###
    dmenu = rofi -dmenu -p dunst
    browser = xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst

    ### Mouse ###
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

# -------------------------------------------------------------------
# Urgency levels
# -------------------------------------------------------------------

[urgency_low]
    background = "#15151fb3"
    foreground = "#8b8fa3"
    frame_color = "#46495e"
    highlight = "#8891b5"
    timeout = 5

[urgency_normal]
    background = "#15151fb3"
    foreground = "#d6d9e6"
    frame_color = "#8891b5"
    highlight = "#8891b5"
    timeout = 8

[urgency_critical]
    background = "#15151fd9"
    foreground = "#d6d9e6"
    frame_color = "#a56868"
    highlight = "#a56868"
    timeout = 0

# -------------------------------------------------------------------
# Example per-app rules (edit / remove as needed)
# -------------------------------------------------------------------

[spotify]
    appname = Spotify
    background = "#2a2d3ecc"
    foreground = "#d6d9e6"
    frame_color = "#8891b5"

[volume]
    appname = "changeVolume"
    background = "#15151fb3"
    foreground = "#d6d9e6"
    frame_color = "#8891b5"
    timeout = 2

[battery-critical]
    appname = "Battery"
    urgency = critical
    background = "#15151fd9"
    foreground = "#d6d9e6"
    frame_color = "#a56868"
